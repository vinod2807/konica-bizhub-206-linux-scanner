#!/bin/sh
# Desktop wrapper for the Konica Minolta bizhub 206 USB scanner.
# Usage: konica206-scan [rotation]     (rotation: 0, 90, 180, 270)
set -u

ROTATE="${1:-90}"
DIR="${HOME}/Scans"
mkdir -p "$DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
BASE="$DIR/konica206-$STAMP"
TOOL="/home/vinod/konica-scanner-re/tools/ar206_scan.py"

echo "Konica Minolta bizhub 206 - A4 mono, 300 dpi"
echo "Output: $BASE.png / $BASE.pdf"
echo

if ! python3 "$TOOL" --paper a4 --dpi 300 --rotate "$ROTATE" \
        --out "$BASE.png" --pdf "$BASE.pdf"; then
    echo
    echo "Scan failed."
    echo "If the scanner stopped responding, power-cycle it and try again."
    printf "Press Enter to close..."
    read -r _
    exit 1
fi

echo
echo "Saved:"
echo "  $BASE.png"
echo "  $BASE.pdf"
xdg-open "$BASE.pdf" >/dev/null 2>&1 &
sleep 1
